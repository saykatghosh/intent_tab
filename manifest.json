{
  "manifest_version": 3,
  "name": "Intent Tab",
  "version": "1.3.0",
  "description": "A calm new tab that asks why you opened it. To-dos, bookmarks, focus timer and on-device AI.",
  "action": {
    "default_title": "Intent Tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "bookmarks",
    "favicon",
    "topSites",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "popup.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
